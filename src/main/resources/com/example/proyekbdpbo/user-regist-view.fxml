<AnchorPane prefHeight="720.0" prefWidth="360.0" style="-fx-background-color: #fff5e1;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyekbdpbo.user.registController">
