                              <Font name="Arial Rounded MT Bold" size="15.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>
                  <HBox prefHeight="69.0" prefWidth="305.0">
                     <children>
                        <VBox prefHeight="100.0" prefWidth="208.0">
                           <children>
                              <Label prefHeight="16.0" prefWidth="159.0" text="Quantity">
                                 <font>
                                    <Font name="Berlin Sans FB" size="15.0" />
                                 </font>
                                 <VBox.margin>
                                    <Insets top="4.0" />
                                 </VBox.margin>
                              </Label>
                           </children>
                        </VBox>
                        <TextField fx:id="quantityField" prefHeight="25.0" prefWidth="130.0" />
                     </children>
                  </HBox>
                  <Button fx:id="addcartButton" alignment="CENTER" mnemonicParsing="false" prefHeight="30.0" prefWidth="101.0" style="-fx-background-color: #665337;" text="ADD TO CART" textFill="WHITE">
