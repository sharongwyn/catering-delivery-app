<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.proyekbdpbo.user.profileController"
            prefHeight="400.0" prefWidth="600.0">
    <children>
        <HBox layoutY="819.0" prefHeight="77.0" prefWidth="414.0" spacing="50.0">
            <children>
                <ImageView fx:id="homeIcon" fitHeight="54.0" fitWidth="58.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../../images/home.png" />
                    </image>
                </ImageView>
                <ImageView fx:id="orderIcon" fitHeight="54.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../../images/restaurant.png" />
                    </image>
                </ImageView>
                <ImageView fx:id="historyIcon" fitHeight="54.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../../images/order.png" />
                    </image>
                </ImageView>
                <ImageView fx:id="profileIcon" fitHeight="54.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../../images/user.png" />
                    </image>
                </ImageView>
            </children>
            <padding>
                <Insets bottom="20.0" left="35.0" right="35.0" top="20.0" />
            </padding>
        </HBox>
    </children>

</AnchorPane>
