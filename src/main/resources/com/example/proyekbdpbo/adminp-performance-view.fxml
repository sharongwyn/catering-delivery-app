<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="360.0" style="-fx-background-color: #FFFCF7;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyekbdpbo.adminPusat.performanceController">
    <children>
      <TableView fx:id="branchTable" layoutX="29.0" layoutY="169.0" prefHeight="306.0" prefWidth="303.0">
        <columns>
          <TableColumn fx:id="idCol" prefWidth="54.5" text="ID" />
          <TableColumn fx:id="branchNameCol" prefWidth="145.0" text="Branch Name" />
            <TableColumn fx:id="avgRatingCol" prefWidth="102.5" text="Average Rating" />
        </columns>
      </TableView>
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#fff5e1" height="134.0" layoutY="-2.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" width="360.0" />
      <Button fx:id="viewdetailButton" layoutX="252.0" layoutY="494.0" mnemonicParsing="false" onAction="#openDetailView" prefHeight="29.0" prefWidth="80.0" style="-fx-background-color: #665337;" text="View Detail" textFill="WHITE">
         <font>
            <Font name="Arial Bold" size="12.0" />
         </font>
      </Button>
        <HBox layoutX="1.0" layoutY="644.0" prefHeight="76.0" prefWidth="358.0" spacing="68.0" style="-fx-background-color: #FFF5E1;">
            <children>
                <ImageView fx:id="performanceIcon" fitHeight="37.0" fitWidth="34.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../../images/performance.png" />
                    </image>
                    <HBox.margin>
                        <Insets top="3.0" />
                    </HBox.margin>
                </ImageView>
                <ImageView fx:id="menuIcon" fitHeight="54.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../../images/menu.png" />
                    </image>
                </ImageView>
                <ImageView fx:id="promotionIcon" fitHeight="45.0" fitWidth="42.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../../images/marketing.png" />
                    </image>
                </ImageView>
            </children>
            <padding>
                <Insets bottom="10.0" left="44.0" right="44.0" top="15.0" />
            </padding>
        </HBox>
      <Button fx:id="logOut" layoutX="266.0" layoutY="29.0" mnemonicParsing="false" onAction="#logOutButton" style="-fx-background-color: #7B5E57; -fx-border-radius: 5; -fx-background-radius: 5; -fx-border-color: #3E2C23;" text="Log Out" textFill="WHITE">
         <font>
            <Font name="Arial Bold" size="12.0" />
         </font>
      </Button>
      <Label fx:id="titleHomeView" layoutX="30.0" layoutY="64.0" prefHeight="35.0" prefWidth="268.0" text="Hi, Central Admin!">
         <font>
            <Font name="Arial Black" size="24.0" />
         </font>
      </Label>
      <Label layoutX="29.0" layoutY="101.0" text="Here's how the branches are doing.">
         <font>
            <Font name="Arial Rounded MT Bold" size="12.0" />
         </font>
      </Label>
    </children>
</AnchorPane>
