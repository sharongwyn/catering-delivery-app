<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="720.0" prefWidth="360.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyekbdpbo.adminPusat.performanceController">
    <children>
        <HBox layoutY="640.0" prefHeight="79.0" prefWidth="360.0" spacing="120.0" style="-fx-background-color: #FFF5E1;">
            <children>
                <ImageView fx:id="homeIcon" fitHeight="54.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../../images/performance.png" />
                    </image>
                </ImageView>
                <ImageView fx:id="orderIcon" fitHeight="47.0" fitWidth="53.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../../images/marketing.png" />
                    </image>
                </ImageView>
            </children>
            <padding>
                <Insets bottom="15.0" left="75.0" right="75.0" top="15.0" />
            </padding>
        </HBox>
    </children>
</AnchorPane>
