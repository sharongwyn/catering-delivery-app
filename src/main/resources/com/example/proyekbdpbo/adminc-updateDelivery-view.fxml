<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="360.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.proyekbdpbo.adminCabang.updateDeliveryController">
    <children>
        <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#fff5e1" height="720.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" width="360.0" />
        <Label layoutX="38.0" layoutY="106.0" text="Update Delivery">
            <font>
                <Font name="Arial Black" size="21.0" />
            </font>
        </Label>
        <VBox layoutX="44.0" layoutY="225.0" prefHeight="269.0" prefWidth="278.0" spacing="20.0">
            <children>
                <HBox prefHeight="50.0" prefWidth="278.0" spacing="24.0">
                    <children>
                        <Label prefHeight="20.0" prefWidth="94.0" text="Delivery Date">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <DatePicker fx:id="deliveryDatePicker" style="-fx-background-color: #F3E5C9;" />
                    </children>
                </HBox>
                <HBox prefHeight="50.0" prefWidth="278.0" spacing="40.0">
                    <children>
                        <Label prefHeight="20.0" prefWidth="94.0" text="Staff Name">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <ChoiceBox fx:id="staffChoiceBox" prefHeight="26.0" prefWidth="192.0" style="-fx-background-color: #FFFFFF;" />
                    </children>
                </HBox>
                <HBox prefHeight="50.0" prefWidth="278.0" spacing="16.0">
                    <children>
                        <Label prefHeight="20.0" prefWidth="114.0" text="Plate Number">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <ChoiceBox fx:id="plateChoiceBox" prefHeight="26.0" prefWidth="186.0" style="-fx-background-color: #FFFFFF;" />
                    </children>
                </HBox>
                <HBox prefHeight="50.0" prefWidth="278.0" spacing="50.0">
                    <children>
                        <Label text="Delivery Time">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="deliveryTimeField" prefHeight="26.0" prefWidth="85.0" />
                    </children>
                </HBox>
                <HBox prefHeight="50.0" prefWidth="278.0" spacing="30.0">
                    <children>
                        <Label text="Estimated Arrival">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="estimatedArrivalField" prefHeight="26.0" prefWidth="85.0" />
                    </children>
                </HBox>
            </children>
        </VBox>
        <Button fx:id="updateDeliveryButton" layoutX="124.0" layoutY="574.0" mnemonicParsing="false" style="-fx-border-color: #3E2C23; -fx-background-color: #7B5E57; -fx-border-radius: 5; -fx-background-radius: 5;" text="Update Delivery" textFill="WHITE">
            <font>
                <Font name="Segoe UI Bold" size="13.0" />
            </font>
        </Button>
      <Button fx:id="backBtn" layoutX="22.0" layoutY="25.0" mnemonicParsing="false" prefHeight="30.0" prefWidth="35.0" style="-fx-background-color: #665337;" text="🡸" textFill="WHITE" />
    </children>
</AnchorPane>
